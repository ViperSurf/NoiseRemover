{
  "manifest_version": 3,
  "name": "Static, Hiss, Wind & Fan Noise Remover",
  "version": "1.0.0",
  "description": "Real-time <10ms static, hiss, fan drone, and wind remover for tab audio. 100% local & air-gapped.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "dist/background/audio-router.js",
    "type": "module"
  },
  "action": {
    "default_popup": "dist/popup/popup.html",
    "default_title": "Noise Remover (Alt+Shift+N)"
  },
  "commands": {
    "toggle-noise-filter": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "Toggle noise filtering on the active tab"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none';"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
